# frost configuration
# Omitted values use the defaults of the installed binary, so upgrades pick
# up the current defaults without duplicating them in this template.
# The installer backs up your previous config.toml before replacing it.
# Restore selected custom settings from config.toml.backup.* as needed.
# Use scripts/install.sh --no-config to upgrade without resetting settings.
# Example customizations:
# font_size = 14.0  # main content (Block / Chat / VTE and split panes)
# chrome_font_size = 14.0  # top bar + sidebar; omitted legacy values inherit font_size once
# ASCII organism is enabled by default; uncomment to turn it off.
# ascii_organism_enabled = false
# terminal_mode = "block"

# Vim buffer rendering and optional workbench controls are independent.
# Explicitly enter with frost --ide [file-or-project].
[vim9]
native_buffer = true
toolbar = false
buffer_tabs = false
status_bar = false
project_panel = false
tool_panel = false
