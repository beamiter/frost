# frost configuration
# Omitted values use the defaults of the installed binary, so upgrades pick
# up the current defaults without duplicating them in this template.
# The installer tracks template fields in .config.toml.installed-defaults.
# Only changes to the installed template fields trigger config.toml.backup.*.
# Existing configurations without an installation record are adopted unchanged.
# Restore selected custom settings from that private backup as needed.
# Use scripts/install.sh --no-config to always keep your existing configuration.
# Example customizations:
# font_size = 14.0  # main content (Block / Chat and split panes)
# chrome_font_size = 14.0  # top bar + sidebar; omitted legacy values inherit font_size once
# ASCII organism is enabled by default; uncomment to turn it off.
# ascii_organism_enabled = false
# terminal_mode = "block"
# Drag either sidebar's inner edge to resize; omit to retain responsive defaults.
# sidebar_width = 216.0  # navigation, 180..480 logical pixels
# inspector_width = 288.0  # right inspector, 260..520 logical pixels

# Vim buffer rendering and optional workbench controls are independent.
# Explicitly enter with frost --ide [file-or-project].
[vim9]
native_buffer = true
toolbar = false
buffer_tabs = false
status_bar = false
project_panel = false
tool_panel = false
